{
  "swagger": "2.0",
  "info": {
    "title": "User API Documentation",
    "description": "",
    "version": "1.0.0"
  },
  "host": "localhost:8081/api/v0",
  "basePath": "/",
  "schemes": [
    "http",
    "https"
  ],
  "paths": {
    "/gourmand": {
      "get": {
        "summary": "L ensemble des gourmands",
        "description": "Renvoie l ensemble des gourmands",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Ajoute un gourmand",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Permet l ajout d un gourmand",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "JoJo"
                }
              },
              "required": [
                "name"
              ]
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "delete": {
        "summary": "Supprime tous les gourmands",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/gourmand/{name}": {
      "get": {
        "summary": "Permet d obtenir un gourmand",
        "description": "Le gourmand obtenu pas son nom",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "summary": "Permet de supprimer un gourmand",
        "description": "",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/gourmand/achete/{name}": {
      "put": {
        "summary": "Achete un chocolat",
        "description": "",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Permet l achat d un chocolat",
            "schema": {
              "type": "object",
              "properties": {
                "nom": {
                  "type": "string",
                  "example": "Cookie"
                },
                "calories": {
                  "type": "number",
                  "example": 100
                }
              },
              "required": [
                "nom",
                "calories"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  }
}