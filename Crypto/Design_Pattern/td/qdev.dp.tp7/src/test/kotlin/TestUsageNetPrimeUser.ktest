    @Test
    fun testContains1user() {
        val consideredUser = User(
            GENDER.male,
            Name("Rafael", "Gordon"),
            "rafael.gordon@example.com",
            Login("crazysnake563", "arsenal"),
            NAT.GB
        )
        userDAO.addFrom("data/users/1_users.json")
        assertTrue(netPrime.contains(consideredUser))
    }

    @Test
    fun testContains80user() {
        val consideredUser = User(
            GENDER.male,
            Name("Rafael", "Gordon"),
            "rafael.gordon@example.com",
            Login("crazysnake563", "arsenal"),
            NAT.GB
        )
        userDAO.addFrom("data/users/80_users.json")
        assertTrue(netPrime.contains(consideredUser))
    }

    @Test
    fun testContains2user() {
        val consideredUser = User(
            GENDER.male,
            Name("Rafael", "Gordon"),
            "rafael.gordon@example.com",
            Login("crazysnake563", "arsenal"),
            NAT.GB
        )
        userDAO.addFrom("data/users/2_users.json")
        assertFalse(netPrime.contains(consideredUser))
    }


    @Test
    fun testDeleteUser() {
        val consideredUser = User(
            GENDER.male,
            Name("Rafael", "Gordon"),
            "rafael.gordon@example.com",
            Login("crazysnake563", "arsenal"),
            NAT.GB
        )
        userDAO.addFrom("data/users/80_users.json")
        assertEquals(80, netPrime.nbUsers())
        assertTrue(netPrime.contains(consideredUser))

        netPrime.deleteByEmail("rafael.gordon@example.com")
        assertEquals(79, netPrime.nbUsers())
        assertFalse(netPrime.contains(consideredUser))
    }

    @Test
    fun deleteUserNotFound() {
        userDAO.addFrom("data/users/80_users.json")
        assertEquals(80, netPrime.nbUsers())

        assertThrows<UserException> {
            netPrime.deleteByEmail("xxxxx.xxxx@example.com")
        }
        assertEquals(80, netPrime.nbUsers())
    }

